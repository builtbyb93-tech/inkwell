# Template only: no staging resource exists or is approved for provisioning.
NODE_ENV=production
PORT=3000
# Supply the dedicated staging runtime role URL securely in Coolify.
DATABASE_URL=
# Configure staging access controls before exposure.
# Auth/mail/storage variables follow their approved ADRs, using staging-only secrets.

# Dedicated environment-specific HTTPS origin; include the versioned auth base path.
NEXTAUTH_URL=
# Generate/store securely in Coolify; never print/commit the value.
NEXTAUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Enable only after verifying trusted proxy header sanitization.
TRUST_PROXY=false
