# Protected per-environment copy only. Generate RPC/admin values securely.
# Never commit the populated copy. Single-node MVP; not a replicated backup.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
replication_factor = 1
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = ""
[s3_api]
s3_region = "inkwell"
api_bind_addr = "127.0.0.1:3900"
[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token = ""
