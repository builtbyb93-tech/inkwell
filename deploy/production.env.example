# Template only: production provisioning/migration/deployment need separate approval.
NODE_ENV=production
PORT=3000
# Supply a least-privilege production runtime role URL securely in Coolify.
DATABASE_URL=
# Never reuse staging database/storage/auth credentials.
# Migration credentials stay in a separately approved migration job.
# Auth/mail/storage variable names follow their approved ADRs.

# Dedicated environment-specific HTTPS origin; include the versioned auth base path.
NEXTAUTH_URL=
# Generate/store securely in Coolify; never print/commit the value.
NEXTAUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Enable only after verifying trusted proxy header sanitization.
TRUST_PROXY=false

# Dedicated private S3 bucket and scoped runtime key; HTTPS outside loopback.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=inkwell
S3_BUCKET=inkwell-production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Read-only release configuration validation; select an owner-approved immutable image.
INKWELL_ENV=production
INKWELL_IMAGE=
# Backup keys belong to the protected operator environment, never the app image.
# INKWELL_BACKUP_KEY_FILE=/protected/off-host-managed-key

# Coolify release Compose template; owner secrets never enter app environment.
APP_BIND_PORT=3307
POSTGRES_USER=inkwell_production_owner
POSTGRES_PASSWORD=
POSTGRES_DB=inkwell_production
GARAGE_CONFIG_FILE=
