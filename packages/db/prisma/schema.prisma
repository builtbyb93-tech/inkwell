generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  workspace       Workspace?
  passwordHash    String?
  emailVerifiedAt DateTime?     @db.Timestamptz(3)
  displayName     String        @default("")
  authVersion     Int           @default(0)
  version         Int           @default(1)
  aiEnabled       Boolean       @default(false)
  tokens          AuthToken[]
  sessions        AuthSession[]
}

model Workspace {
  plotGroups         PlotGroup[]
  id                 String              @id @default(uuid()) @db.Uuid
  ownerId            String              @unique @db.Uuid
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  canonOverrides     CanonOverride[]
  canonRelationships CanonRelationship[]
  projects           Project[]
  stories            Story[]
  ideas              Idea[]
  ideaCategories     IdeaCategory[]
  ideaTags           IdeaTag[]
  characters         CanonRecord[]
  scenes             Scene[]
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    TokenPurpose
  tokenHash  String       @unique
  expiresAt  DateTime     @db.Timestamptz(3)
  consumedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authVersion Int
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  keyHash     String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(1)

  @@unique([keyHash, windowStart])
  @@index([windowStart])
}

model Project {
  plotGroups         PlotGroup[]
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  title              String
  description        String              @default("")
  version            Int                 @default(1)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  canonOverrides     CanonOverride[]
  canonRelationships CanonRelationship[]
  stories            Story[]
  characters         CanonRecord[]
  scenes             Scene[]
  ideaConversions    IdeaConversion[]

  @@unique([id, workspaceId])
  @@index([workspaceId, archivedAt, createdAt, id])
}

model Story {
  plotGroups  PlotGroup[]
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId   String      @db.Uuid
  project     Project     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  title       String
  synopsis    String      @default("")
  format      String      @default("")
  version     Int         @default(1)
  archivedAt  DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  canonRecords       CanonRecord[]
  canonOverrides     CanonOverride[]
  canonRelationships CanonRelationship[]
  sequenceVersion    Int                 @default(0)
  scenes             Scene[]
  ideaLinks          IdeaStoryLink[]
  conversions        IdeaConversion[]    @relation("ConvertedStory")
  sceneConversions   IdeaConversion[]    @relation("ConversionParentStory")

  @@unique([id, projectId, workspaceId])
  @@index([workspaceId, projectId, archivedAt, createdAt, id])
}

model IdeaCategory {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  nameKey     String
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  ideas       Idea[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, nameKey])
  @@index([workspaceId, createdAt, id])
}

model IdeaTag {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  nameKey     String
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  ideas       IdeaTagAssignment[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, nameKey])
  @@index([workspaceId, createdAt, id])
}

model Idea {
  id                   String                  @id @default(uuid()) @db.Uuid
  workspaceId          String                  @db.Uuid
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  title                String
  content              Json
  contentSchemaVersion Int                     @default(1)
  contentText          String
  searchVector         Unsupported("tsvector") @default(dbgenerated())
  categoryId           String?                 @db.Uuid
  category             IdeaCategory?           @relation(fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  tags                 IdeaTagAssignment[]
  version              Int                     @default(1)
  archivedAt           DateTime?               @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  storyLinks           IdeaStoryLink[]
  sceneLinks           IdeaSceneLink[]
  conversions          IdeaConversion[]

  @@unique([id, workspaceId])
  @@index([workspaceId, archivedAt, createdAt, id])
  @@index([workspaceId, categoryId])
  @@index([searchVector], type: Gin)
}

model IdeaTagAssignment {
  ideaId      String  @db.Uuid
  tagId       String  @db.Uuid
  workspaceId String  @db.Uuid
  idea        Idea    @relation(fields: [ideaId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  tag         IdeaTag @relation(fields: [tagId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([ideaId, tagId])
  @@index([workspaceId, tagId, ideaId])
}

model CanonRecord {
  sceneCharacters      SceneCharacterLink[]
  sceneLocations       SceneLocationLink[]
  id                   String               @id @default(uuid()) @db.Uuid
  workspaceId          String               @db.Uuid
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId            String               @db.Uuid
  project              Project              @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  kind                 CanonKind            @default(CHARACTER)
  scope                CanonScope           @default(SHARED)
  storyId              String?              @db.Uuid
  story                Story?               @relation(fields: [storyId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  overrides            CanonOverride[]
  outgoing             CanonRelationship[]  @relation("CanonFrom")
  incoming             CanonRelationship[]  @relation("CanonTo")
  name                 String
  content              Json
  contentSchemaVersion Int                  @default(1)
  contentText          String
  version              Int                  @default(1)
  archivedAt           DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  conversions          IdeaConversion[]

  @@unique([id, projectId, workspaceId])
  @@index([workspaceId, projectId, scope, storyId, kind, archivedAt])
  @@index([workspaceId, projectId, archivedAt, createdAt, id])
  @@map("Character")
}

model Scene {
  status               SceneStatus          @default(PLANNED)
  groupId              String?              @db.Uuid
  group                PlotGroup?           @relation(fields: [groupId, storyId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  duplicatedFromId     String?              @db.Uuid
  duplicatedFrom       Scene?               @relation("SceneCopies", fields: [duplicatedFromId, storyId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  copies               Scene[]              @relation("SceneCopies")
  characters           SceneCharacterLink[]
  locations            SceneLocationLink[]
  id                   String               @id @default(uuid()) @db.Uuid
  workspaceId          String               @db.Uuid
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId            String               @db.Uuid
  project              Project              @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  storyId              String               @db.Uuid
  story                Story                @relation(fields: [storyId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  title                String
  content              Json
  contentSchemaVersion Int                  @default(1)
  contentText          String
  position             Int
  version              Int                  @default(1)
  archivedAt           DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  ideaLinks            IdeaSceneLink[]
  conversions          IdeaConversion[]

  @@unique([id, storyId, projectId, workspaceId])
  @@unique([storyId, position])
  @@index([workspaceId, projectId, storyId, groupId, archivedAt, position])
  @@index([duplicatedFromId, storyId, projectId, workspaceId])
  @@index([workspaceId, projectId, storyId, archivedAt, createdAt, id])
}

model IdeaStoryLink {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  ideaId      String   @db.Uuid
  idea        Idea     @relation(fields: [ideaId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectId   String   @db.Uuid
  storyId     String   @db.Uuid
  story       Story    @relation(fields: [storyId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([ideaId, storyId])
  @@index([workspaceId, storyId])
  @@index([ideaId, createdAt, id])
}

model IdeaSceneLink {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  ideaId      String   @db.Uuid
  idea        Idea     @relation(fields: [ideaId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectId   String   @db.Uuid
  storyId     String   @db.Uuid
  sceneId     String   @db.Uuid
  scene       Scene    @relation(fields: [sceneId, storyId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([ideaId, sceneId])
  @@index([workspaceId, sceneId])
  @@index([ideaId, createdAt, id])
  @@index([workspaceId, storyId, ideaId])
}

enum IdeaConversionKind {
  STORY
  CHARACTER
  SCENE
}

model IdeaConversion {
  id                         String             @id @default(uuid()) @db.Uuid
  workspaceId                String             @db.Uuid
  requestKey                 String             @db.Uuid
  requestHash                String
  ideaId                     String             @db.Uuid
  idea                       Idea               @relation(fields: [ideaId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  projectId                  String             @db.Uuid
  project                    Project            @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  parentStoryId              String?            @db.Uuid
  parentStory                Story?             @relation("ConversionParentStory", fields: [parentStoryId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  targetStoryId              String?            @db.Uuid
  targetStory                Story?             @relation("ConvertedStory", fields: [targetStoryId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  targetCharacterId          String?            @db.Uuid
  targetCharacter            CanonRecord?       @relation(fields: [targetCharacterId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  targetSceneId              String?            @db.Uuid
  targetScene                Scene?             @relation(fields: [targetSceneId, parentStoryId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  kind                       IdeaConversionKind
  sourceVersion              Int
  titleSnapshot              String
  contentSnapshot            Json
  sourceContentSchemaVersion Int                @default(1)
  createdAt                  DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([workspaceId, requestKey])
  @@index([ideaId, createdAt, id])
  @@index([workspaceId, targetStoryId])
  @@index([workspaceId, targetCharacterId])
  @@index([workspaceId, targetSceneId])
  @@index([workspaceId, parentStoryId])
  @@index([projectId, workspaceId])
}

enum CanonKind {
  CHARACTER
  LOCATION
  LORE
  EVENT
  ORGANIZATION
}

enum CanonScope {
  SHARED
  STORY
}

enum CanonRelationshipKind {
  RELATED
  KNOWS
  MEMBER_OF
  LOCATED_IN
  PART_OF
  PRECEDES
}

model CanonOverride {
  id                       String      @id @default(uuid()) @db.Uuid
  workspaceId              String      @db.Uuid
  workspace                Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId                String      @db.Uuid
  project                  Project     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  storyId                  String      @db.Uuid
  story                    Story       @relation(fields: [storyId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  canonId                  String      @db.Uuid
  canon                    CanonRecord @relation(fields: [canonId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  hasName                  Boolean     @default(false)
  name                     String?
  hasContent               Boolean     @default(false)
  contentText              String?
  content                  Json?
  contentSchemaVersion     Int         @default(1)
  baseVersion              Int
  baseName                 String
  baseContent              Json
  baseContentSchemaVersion Int         @default(1)
  version                  Int         @default(1)
  createdAt                DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([canonId, storyId])
  @@index([workspaceId, projectId, storyId])
}

model CanonRelationship {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @db.Uuid
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId   String                @db.Uuid
  project     Project               @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  storyId     String?               @db.Uuid
  story       Story?                @relation(fields: [storyId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  fromId      String                @db.Uuid
  from        CanonRecord           @relation("CanonFrom", fields: [fromId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  toId        String                @db.Uuid
  to          CanonRecord           @relation("CanonTo", fields: [toId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  kind        CanonRelationshipKind
  label       String                @default("")
  version     Int                   @default(1)
  archivedAt  DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([storyId, fromId, toId, kind])
  @@index([workspaceId, projectId, fromId, archivedAt, createdAt, id])
  @@index([workspaceId, projectId, toId, archivedAt, createdAt, id])
}

enum SceneStatus {
  PLANNED
  DRAFT
  REVIEW
  COMPLETE
}

model PlotGroup {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId   String      @db.Uuid
  project     Project     @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  storyId     String      @db.Uuid
  story       Story       @relation(fields: [storyId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  parentId    String?     @db.Uuid
  parent      PlotGroup?  @relation("PlotChildren", fields: [parentId, storyId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  children    PlotGroup[] @relation("PlotChildren")
  title       String
  description String      @default("")
  version     Int         @default(1)
  archivedAt  DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  scenes      Scene[]

  @@unique([id, storyId, projectId, workspaceId])
  @@index([workspaceId, projectId, storyId, parentId, archivedAt, createdAt, id])
}

model SceneCharacterLink {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String      @db.Uuid
  storyId     String      @db.Uuid
  sceneId     String      @db.Uuid
  scene       Scene       @relation(fields: [sceneId, storyId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  canonId     String      @db.Uuid
  canon       CanonRecord @relation(fields: [canonId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([sceneId, canonId])
  @@index([workspaceId, projectId, canonId, createdAt, id])
  @@index([workspaceId, storyId, sceneId])
}

model SceneLocationLink {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String      @db.Uuid
  storyId     String      @db.Uuid
  sceneId     String      @db.Uuid
  scene       Scene       @relation(fields: [sceneId, storyId, projectId, workspaceId], references: [id, storyId, projectId, workspaceId], onDelete: Restrict)
  canonId     String      @db.Uuid
  canon       CanonRecord @relation(fields: [canonId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([sceneId, canonId])
  @@index([workspaceId, projectId, canonId, createdAt, id])
  @@index([workspaceId, storyId, sceneId])
}
