{
  "name": "inkwell",
  "private": true,
  "version": "0.6.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "pnpm db:generate && pnpm --filter @inkwell/web build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env scripts/integration.mjs",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e.mjs",
    "db:generate": "node --env-file-if-exists=.env scripts/database.mjs generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate deploy",
    "db:validate": "node --env-file-if-exists=.env scripts/database.mjs validate",
    "check": "pnpm peers check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "security:secrets": "node scripts/secret-scan.mjs",
    "storage:local": "node --env-file-if-exists=.env scripts/storage-local.mjs",
    "backup:local": "node --env-file-if-exists=.env scripts/backup-local.mjs",
    "release:check": "node --env-file-if-exists=.env scripts/release-check.mjs",
    "release:compose-check": "node scripts/release-compose-check.mjs",
    "test:backup": "node --env-file-if-exists=.env scripts/integration.mjs --backup"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "typescript-eslint": "8.72.2",
    "@inkwell/contracts": "workspace:*",
    "@inkwell/domain": "workspace:*",
    "@inkwell/db": "workspace:*",
    "vite": "8.3.8",
    "@inkwell/storage": "workspace:*",
    "@aws-sdk/client-s3": "3.1168.0",
    "@inkwell/operations": "workspace:*"
  },
  "type": "module"
}
