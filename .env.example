# Development only. Copy to .env; never use these values on a public host.
DATABASE_URL=postgresql://inkwell:inkwell_dev_only@127.0.0.1:55439/inkwell_dev
POSTGRES_USER=inkwell
POSTGRES_PASSWORD=inkwell_dev_only
POSTGRES_DB=inkwell_dev
POSTGRES_PORT=55439
APP_PORT=3006
E2E_PORT=3700
# Distinct worktrees must use distinct COMPOSE_PROJECT_NAME, ports and databases.
COMPOSE_PROJECT_NAME=inkwell_phase7
# AI remains disabled; no provider credential is required.

# Generate a unique local secret directly in .env with the README command. Never print it in reports.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3006/api/v1/auth
SMTP_HOST=127.0.0.1
SMTP_PORT=11031
SMTP_FROM=Inkwell <no-reply@example.test>
SMTP_SECURE=false
MAILPIT_HTTP_PORT=18031
MAILPIT_URL=http://127.0.0.1:18031
# False unless the trusted reverse proxy strips client-supplied forwarding headers.
TRUST_PROXY=false

# Local S3: pnpm storage:local generates ignored credentials and verifies privacy.
S3_ENDPOINT=http://127.0.0.1:13907
S3_PORT=13907
S3_REGION=inkwell
S3_BUCKET=inkwell-phase7
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
